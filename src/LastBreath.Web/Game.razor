@inject IJSRuntime JS
@inject GameConfig Config
@inject IReadOnlyList<DiveInfo> Dives

@if (ready)
{
    <div class="app @(round is not null ? "staged" : "") @(maths ? "maths" : "")">
        @if (!reduceMotion)
        {
            <div class="bubbles" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
        }
        <header class="top">
            <h1 class="brand"><svg class="logo" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><use href="#mark" /></svg><span class="brand-name">Last Breath</span></h1>
            <p class="balance">Balance <strong data-testid="balance" @ref="balanceValue">@Format.Credits(balance)</strong></p>
            @if (round is not null)
            {
                <p class="balance">Bet <strong>@Format.Credits(roundBet)</strong></p>
            }
            @* The visible word is short on a phone, and the name stays whole, so it always contains what is shown. *@
            <button type="button" class="switch" role="switch" aria-checked="@(maths ? "true" : "false")" aria-label="Show the maths" @onclick="ToggleMaths">
                <span class="switch-track" aria-hidden="true"></span><span class="switch-text"><span class="switch-long">Show the </span>maths</span>
            </button>
            @* A player sees one maths control, the switch. The Math panel has its button in the maths view, and the M key opens it in both. *@
            @if (maths)
            {
                <button type="button" @ref="mathButton" @onclick="OpenMath" aria-keyshortcuts="M">Math</button>
            }
        </header>

        <main>
            @if (round is null)
            {
                <DiveSelect Dives="Dives" Bets="Config.Bets" Balance="balance" Maths="maths"
                            Selected="@selectedDive" SelectedChanged="Pick"
                            Bet="bet" BetChanged="PickBet"
                            FocusDive="returned" OnDive="StartRound" />
            }
            else
            {
                <RoundView @ref="roundView" @key="roundNumber" Round="round" DiveId="@selectedDive" Bet="roundBet" Session="session" ReduceMotion="reduceMotion"
                           Maths="maths" CanDiveAgain="balance >= bet"
                           Announce="Say" Finished="Settle" DiveAgain="StartRound" ChangeDive="ChangeDive" />
            }
        </main>

        <footer>
            <p>Demo with play money. Nothing is paid out.</p>
            <details class="keys">
                <summary>Keys</summary>
                <p>1 to 3 choose a dive. S skips to the end of a round. M opens the math. Escape closes the math or this list. Space or Enter presses the button in focus.</p>
            </details>
            <label class="toggle">
                <input type="checkbox" checked="@reduceMotion" disabled="@systemReducesMotion" @onchange="ToggleMotion" />
                Reduce motion
                @if (systemReducesMotion) { <span>(set by your system)</span> }
            </label>
            <button type="button" class="quiet" disabled="@roundActive" @onclick="ResetBalance">Reset balance</button>
        </footer>

        <MathPanel @ref="math" Dives="Dives" Seed="lastSeed" SeedDiveId="@lastSeedDive" />

        <div class="sr-only" aria-live="polite" aria-atomic="true">@announcement</div>
    </div>
}

@code {
    private const string DiveKey = "lastbreath.dive";
    private const string BetKey = "lastbreath.bet";
    private const string MotionKey = "lastbreath.reduce";
    private const string MathsKey = "lastbreath.maths";
    private const decimal StartingBalance = 1000.00m;

    private readonly Session session = new();
    private bool ready;
    private bool maths;
    private bool systemReducesMotion;
    private bool reduceMotionChoice;
    private bool returned;
    private bool roundActive;
    private decimal balance = StartingBalance;
    private string selectedDive = "Classic";
    private decimal bet = 1.00m;
    private decimal roundBet;
    private Round? round;
    private int roundNumber;
    private ulong? fixedSeed;
    private string announcement = "";
    private ulong? lastSeed;
    private string? lastSeedDive;
    private RoundView? roundView;
    private MathPanel? math;
    private ElementReference mathButton;
    private ElementReference balanceValue;
    private decimal countedFrom;
    private int balanceCountMs;

    private bool reduceMotion => systemReducesMotion || reduceMotionChoice;

    protected override async Task OnInitializedAsync()
    {
        var dive = await JS.InvokeAsync<string?>("lastBreath.read", DiveKey);
        if (Dives.Any(info => info.Id == dive)) selectedDive = dive!;

        var stored = await JS.InvokeAsync<string?>("lastBreath.read", BetKey);
        if (decimal.TryParse(stored, NumberStyles.Number, CultureInfo.InvariantCulture, out var storedBet) && Config.Bets.Contains(storedBet))
            bet = storedBet;

        // A visitor can add ?seed=<number> to replay the same rounds: the first uses the seed, the next seed + 1, and so on.
        // The tests use it to reach a Tank round that lands an air tank. Without it every round takes a fresh crypto seed.
        if (ulong.TryParse(await JS.InvokeAsync<string?>("lastBreath.queryValue", "seed"), out var seed))
            fixedSeed = seed;

        systemReducesMotion = await JS.InvokeAsync<bool>("lastBreath.prefersReducedMotion");
        reduceMotionChoice = await JS.InvokeAsync<string?>("lastBreath.read", MotionKey) == "1";
        maths = await JS.InvokeAsync<string?>("lastBreath.read", MathsKey) == "1";
        await JS.InvokeVoidAsync("lastBreath.listenKeys", DotNetObjectReference.Create(this));
        ready = true;
        _ = WarmUp();
    }

    // The odds line on the result plate needs the award distribution of the dive. It is built here, one dive at a time and
    // after the first frame, so that no round waits for it. A round that ends sooner builds the one it needs itself.
    private async Task WarmUp()
    {
        await Task.Delay(1500);
        foreach (var info in Dives)
        {
            Survival.For(Config, info);
            await Task.Delay(300);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (balanceCountMs == 0) return;
        var ms = balanceCountMs;
        balanceCountMs = 0;
        await JS.InvokeVoidAsync("lastBreath.countUp", balanceValue, countedFrom, balance, ms);
    }

    private async Task Pick(string id)
    {
        selectedDive = id;
        await JS.InvokeVoidAsync("lastBreath.write", DiveKey, id);
    }

    private async Task PickBet(decimal value)
    {
        bet = value;
        await JS.InvokeVoidAsync("lastBreath.write", BetKey, value.ToString(CultureInfo.InvariantCulture));
    }

    private async Task StartRound()
    {
        if (roundActive || balance < bet) return;

        var seed = fixedSeed is { } fixedStart
            ? unchecked(fixedStart + (ulong)roundNumber)
            : ulong.Parse(await JS.InvokeAsync<string>("lastBreath.randomSeed"), CultureInfo.InvariantCulture);
        lastSeed = seed;
        lastSeedDive = selectedDive;
        round = Engines.For(selectedDive)(Config, Config.Dives[selectedDive], new Pcg32Random(seed));
        roundBet = bet;
        balance -= bet;
        roundActive = true;
        returned = false;
        roundNumber++;
    }

    // A big win that plays out counts the balance up with its number, so the header never runs ahead of the result. A skipped round and
    // reduced motion credit it at once.
    private void Settle(decimal win)
    {
        balanceCountMs = roundView?.WinCountMs ?? 0;
        countedFrom = balance;
        balance += win;
        roundActive = false;
        session.Add(Dives.First(dive => dive.Id == selectedDive).Name, roundBet, win);
    }

    private void ChangeDive()
    {
        round = null;
        returned = true;
    }

    private void ResetBalance()
    {
        balance = StartingBalance;
        session.Clear();
        Say($"Balance reset to {Format.Credits(balance)} credits.");
    }

    private async Task ToggleMotion(ChangeEventArgs change)
    {
        reduceMotionChoice = change.Value is true;
        await JS.InvokeVoidAsync("lastBreath.write", MotionKey, reduceMotionChoice ? "1" : "0");
    }

    private async Task ToggleMaths()
    {
        maths = !maths;
        await JS.InvokeVoidAsync("lastBreath.write", MathsKey, maths ? "1" : "0");
    }

    private async Task OpenMath()
    {
        if (math is not null) await math.Open(maths ? mathButton : null);
    }

    [JSInvokable]
    public async Task OnKey(string key)
    {
        if (round is null && int.TryParse(key, out var number) && number >= 1 && number <= Dives.Count)
            await Pick(Dives[number - 1].Id);
        else if (key.Equals("s", StringComparison.OrdinalIgnoreCase) && roundView is not null)
            await roundView.Skip();
        else if (key.Equals("m", StringComparison.OrdinalIgnoreCase))
            await OpenMath();
        StateHasChanged();
    }

    private void Say(string message) => announcement = message;
}
