@implements IDisposable
@inject GameConfig Config
@inject IJSRuntime JS
@inject IReadOnlyList<DiveInfo> Dives

<section class="round @(finished ? "over" : "") @(ReduceMotion ? "" : "moves")" style="--air: @Format.Number(Air, 3)" aria-labelledby="round-title">
    <div class="side">
        <div class="round-head">
            <h2 id="round-title">@dive.Name</h2>
            <p class="meta"><span class="bet">Bet @Format.Credits(Bet)</span> <span class="spin">Spin @shown</span></p>
        </div>

        <div class="hud">
            @switch (DiveId)
            {
                case "Classic":
                    <div class="clock">
                        <p class="clock-text">Oxygen <strong>@clock of @dive.RefillTo</strong></p>
                        <span class="pips" aria-hidden="true">
                            @for (var i = 0; i < dive.RefillTo; i++)
                            {
                                <svg class="pip bottle" aria-hidden="true" focusable="false"><use href="#@(Bottle(i < clock, lastBreath))" /></svg>
                            }
                        </span>
                        <p class="last @(lastBreath ? "" : "off")">Last breath</p>
                    </div>
                    break;
                case "Static":
                    <div class="clock">
                        <p class="clock-text">Spins left <strong>@clock of @dive.StartingClock</strong></p>
                        <span class="pips" aria-hidden="true">
                            @for (var i = 0; i < dive.StartingClock; i++)
                            {
                                <span class="pip segment @(i < clock ? "on" : "")"></span>
                            }
                        </span>
                    </div>
                    break;
                default:
                    <div class="clock">
                        <p class="clock-text">
                            Air <strong>@clock</strong>
                            @if (gain > 0)
                            {
                                <span class="gain @(ReduceMotion ? "" : "anim-fly")" data-testid="gain" @key="shown">+@gain</span>
                            }
                        </p>
                        <p class="clock-text">Spare tanks <strong>@tanksLeft of @dive.TankLimit</strong></p>
                        <span class="pips" aria-hidden="true">
                            @for (var i = 0; i < dive.TankLimit; i++)
                            {
                                <AirTankImage Class="@(i < tanksLeft ? "pip tank-pip" : "pip tank-pip spent")" />
                            }
                        </span>
                        <p class="last @(lastBreath ? "" : "off")">Last breath</p>
                    </div>
                    break;
            }
            <p class="total" title="@(Format.Multiple(units))× bet">Board <strong @ref="totalValue">@Format.Credits(Settlement.Credits(units, Bet))</strong><span class="sr-only"> credits, @(Format.Multiple(units)) times the bet</span></p>
        </div>

        @if (finished)
        {
            <div class="result">
                <section class="summary" tabindex="-1" @ref="summary" aria-labelledby="summary-title">
                    <h3 id="summary-title">Round over</h3>
                    <dl>
                        <div><dt>Spins</dt><dd>@outcome.Spins</dd></div>
                        <div><dt>Crates</dt><dd>@outcome.Crates</dd></div>
                        @if (outcome.Jackpots.Length > 0)
                        {
                            <div><dt>Jackpots</dt><dd>@string.Join(", ", outcome.Jackpots)</dd></div>
                        }
                        @if (outcome.Grand)
                        {
                            <div><dt>Grand</dt><dd>Won, @Narration.Credits(Config.Grand, Bet)</dd></div>
                        }
                    </dl>
                    @if (!CanDiveAgain)
                    {
                        <p class="note">Not enough credits for another dive at this bet.</p>
                    }
                </section>
            </div>
        }

        @if (!finished)
        {
            <ol class="ticker" aria-label="Spins so far, newest first">
                @if (shown == 0)
                {
                    <li class="ticker-empty">No spin yet.</li>
                }
                @foreach (var row in Narration.Ticker(Config, Bet, spins, shown))
                {
                    <li @key="row.Key" title="@row.What"><span class="ticker-spin">@row.Label</span> <span class="ticker-what">@row.What</span></li>
                }
            </ol>
        }

        @if (Session.Rounds > 0)
        {
            <SessionPanel Session="Session" Dive="info" />
        }

        <div class="actions">
            @if (finished)
            {
                <button type="button" class="primary" disabled="@(!CanDiveAgain)" @onclick="DiveAgain">Dive again</button>
                <button type="button" @onclick="ChangeDive">Change dive</button>
            }
            else
            {
                <button type="button" @ref="skipButton" @onclick="Skip" aria-keyshortcuts="S">Skip</button>
            }
        </div>

        @if (finished)
        {
            <details class="spinlog">
                <summary>Spin by spin (@spins.Length)</summary>
                <ol class="ticker" aria-label="Spin by spin, newest first">
                    @foreach (var row in Narration.Ticker(Config, Bet, spins, shown))
                    {
                        <li @key="row.Key" title="@row.What"><span class="ticker-spin">@row.Label</span> <span class="ticker-what">@row.What</span></li>
                    }
                </ol>
            </details>
        }
    </div>

    <div class="stage">
        <div class="board @(showsBreathBand ? "last-breath" : "")" @ref="boardRef" role="group" aria-label="Board, five columns by three rows">
            <svg class="panel" aria-hidden="true" focusable="false"><use href="#panel" /></svg>
            @if (DiveId != "Static") { <p class="breath-band @(showsBreathBand ? "" : "off")" aria-hidden="true">Last breath</p> }
            @for (var index = 0; index < Board.Size; index++)
            {
                var tile = TileAt(index);
                <div class="tile tile-@tile.Kind @(tile.Kind == "empty" ? "" : "tile-drawn") @RingClass(tile.Kind is "mini" or "minor" or "major", tile.IsNew)" role="img" aria-label="@tile.Name" title="@tile.Tip">
                    <svg class="well" viewBox="0 0 115 100" aria-hidden="true" focusable="false"><use href="#well-@WellPattern[index]" /></svg>
                    @if (tile.Kind != "empty")
                    {
                        <span class="coin @(tile.IsNew && !ReduceMotion ? "anim-in" : "")">
                            @if (tile.Art == AirTankArt)
                            {
                                <AirTankImage Class="art" />
                            }
                            else
                            {
                                <svg class="art" viewBox="0 0 115 100" aria-hidden="true" focusable="false" style="--tilt: @Tilts[index * 7 % Tilts.Length]"><use href="#@tile.Art" /></svg>
                            }
                            <span class="tile-plate"><span class="tile-value">@tile.Value</span></span>
                        </span>
                    }
                </div>
            }
            <div class="board-foot @(finished ? $"result-plate {outcome.Kind}" : "status")">
                @if (finished)
                {
                    <div class="plate-main">
                        @if (outcome.BigWin) { <svg class="plate-medal" viewBox="0 0 115 100" aria-hidden="true" focusable="false"><use href="#medal-major" /></svg> }
                        @if (outcome.Units == 0)
                        {
                            <p class="plate-zero">Surfaced with nothing</p>
                            <span class="sr-only">Total win <strong data-testid="win">@Format.Credits(Settlement.Credits(outcome.Units, Bet))</strong> credits</span>
                        }
                        else
                        {
                            <div class="plate-figures">
                                <p class="plate-win"><strong data-testid="win">@Format.Credits(Settlement.Credits(outcome.Units, Bet))</strong> <span>credits</span></p>
                                <p class="plate-times">@PlateTimes</p>
                            </div>
                        }
                    </div>
                    <div class="plate-note">
                        @if (outcome.BigWin) { <p class="big-win">Big win</p> }
                        @if (OddsLine is { } line) { <p class="odds">@line</p> }
                    </div>
                }
                else
                {
                    <p class="foot-spin">Spin @shown</p>
                    <p class="foot-what">@(current is { } landed ? Narration.Brief(Config, Bet, landed) : "Nothing has landed yet")</p>
                }
            </div>
        </div>

        <ul class="prizes" aria-label="Jackpots">
            @foreach (var prize in Prizes())
            {
                <li class="prize @(prize.Hit ? "hit" : "") @(prize.Label == "Grand" ? "grand" : "") @(prize.IsNew && !ReduceMotion ? "anim-in" : "") @RingClass(prize.Hit, prize.IsNew)" aria-label="@prize.Name" title="@prize.Tip">
                    <svg class="medal" viewBox="0 0 115 100" aria-hidden="true" focusable="false"><use href="#medal-@(prize.Label.ToLowerInvariant())" /></svg>
                    <span class="prize-text">
                        <span class="prize-name">@prize.Label</span>
                        <span class="prize-value">@prize.Value</span>
                        @if (prize.Hit) { <span class="prize-state"><span class="badge">@prize.State</span></span> }
                    </span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    // The board total counts up to what a spin added: briefly for crates, and for longer when a jackpot landed.
    private const int CountMs = 300;
    private const int JackpotCountMs = 900;

    private readonly CancellationTokenSource stop = new();
    private DiveConfig dive = default!;
    private Spin[] spins = [];
    private RoundSummary outcome = default!;
    private int shown;
    private bool finished;
    private bool focusSummary;
    private int countedUnits;
    private ElementReference skipButton;
    private ElementReference summary;
    private ElementReference boardRef;
    private ElementReference totalValue;

    [Parameter, EditorRequired] public Round Round { get; set; } = default!;
    [Parameter, EditorRequired] public string DiveId { get; set; } = "";
    [Parameter] public decimal Bet { get; set; }
    [Parameter, EditorRequired] public Session Session { get; set; } = default!;
    [Parameter] public bool ReduceMotion { get; set; }
    [Parameter] public bool CanDiveAgain { get; set; }
    [Parameter] public EventCallback<string> Announce { get; set; }
    [Parameter] public EventCallback<decimal> Finished { get; set; }
    [Parameter] public EventCallback DiveAgain { get; set; }
    [Parameter] public EventCallback ChangeDive { get; set; }

    private DiveInfo info => Dives.First(dive => dive.Id == DiveId);

    private string? OddsLine => Odds.Line(info.Name, info.Figures.Rtp, outcome.Units, Survival.For(Config, info));

    private string PlateTimes => outcome.Kind == "under"
        ? $"Returned {Format.Credits(Settlement.Credits(outcome.Units, Bet))} of your {Format.Credits(Bet)} bet"
        : $"{Format.Multiple(outcome.Units)}× bet";

    // How much air is left, from 0 to 1, of the most the dive can have at this point: the refill in Classic, the spins in Drift, and in Tank
    // the starting air plus every breath the tanks have added so far. The water darkens as it falls, and the dive surfaces when the round ends.
    private double Air
    {
        get
        {
            if (finished || shown == 0) return 1;
            var most = DiveId switch
            {
                "Classic" => dive.RefillTo ?? dive.StartingClock,
                "Static" => dive.StartingClock,
                _ => dive.StartingClock + spins.Take(shown).Sum(spin => spin.AirTanks.Sum(tank => tank.Outcome.Breaths())),
            };
            return Math.Clamp((double)clock / Math.Max(1, most), 0, 1);
        }
    }

    private bool JackpotLanded => current is { } spin && spin.NewCells.Any(index => spin.Cells[index].Kind == CellKind.Jackpot);

    // A jackpot that lands gives one pulse of a ring, on its tile and on its card. With reduced motion the ring is there, still, for as long as the jackpot is.
    private string RingClass(bool jackpot, bool isNew) => !jackpot ? "" : ReduceMotion ? "ring-static" : isNew ? "anim-ring" : "";

    private Spin? current => shown > 0 ? spins[shown - 1] : null;
    private int clock => current?.ClockAfter ?? dive.StartingClock;
    private int tanksLeft => current?.TanksLeft ?? dive.TankLimit ?? 0;
    private int units => current?.BoardUnits ?? 0;
    private int gain => current?.AirTanks.Sum(tank => tank.Outcome.Breaths()) ?? 0;
    private bool lastBreath => clock == 1 && !finished;
    private bool showsBreathBand => lastBreath && DiveId != "Static";

    protected override void OnInitialized()
    {
        dive = Config.Dives[DiveId];
        spins = Replay.Of(Round, dive);
        outcome = Replay.Summary(Config, Round);
        _ = Play();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
            await skipButton.FocusAsync(preventScroll: true);
        }
        if (units != countedUnits)
        {
            var from = Settlement.Credits(countedUnits, Bet);
            countedUnits = units;
            if (!ReduceMotion) await JS.InvokeVoidAsync("lastBreath.countUp", totalValue, from, Settlement.Credits(units, Bet), JackpotLanded ? JackpotCountMs : CountMs);
        }
        if (focusSummary)
        {
            focusSummary = false;
            await summary.FocusAsync(preventScroll: true);
            await JS.InvokeVoidAsync("lastBreath.reveal", boardRef);
        }
    }

    private async Task Play()
    {
        try
        {
            await Task.Delay(Pacing.StartMs, stop.Token);
            while (shown < spins.Length)
            {
                shown++;
                StateHasChanged();
                await Announce.InvokeAsync(Narration.Landing(Config, DiveId, Bet, spins[shown - 1]));
                await Task.Delay(Pacing.Pause(spins[shown - 1]), stop.Token);
            }
            await Finish(skipped: false);
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async Task Skip()
    {
        if (finished) return;
        await stop.CancelAsync();
        shown = spins.Length;
        await Finish(skipped: true);
    }

    private async Task Finish(bool skipped)
    {
        finished = true;
        focusSummary = true;
        StateHasChanged();
        await Announce.InvokeAsync(Narration.Result(Config, Bet, outcome, skipped));
        await Finished.InvokeAsync(Settlement.Credits(outcome.Units, Bet));
    }

    public void Dispose() => stop.Dispose();

    private sealed record Tile(string Kind, string Value, string Name, string Tip, bool IsNew, string? Art = null);

    private Tile TileAt(int index)
    {
        var place = $"Column {index / Board.Rows + 1}, row {index % Board.Rows + 1}";
        var tank = current?.AirTanks.Where(landed => landed.Index == index).Select(landed => (Landed?)landed).FirstOrDefault();
        if (tank is { } airTank)
        {
            var breaths = airTank.Outcome.Breaths();
            return new Tile("tank", $"+{breaths}", $"{place}: air tank, plus {breaths} {(breaths == 1 ? "breath" : "breaths")}", $"+{breaths} breaths", true, AirTankArt);
        }

        var cell = current?.Cells[index] ?? default;
        if (cell.IsEmpty) return new Tile("empty", "", $"{place}: empty", "", false);

        var label = Narration.Label(Config, cell);
        var multiple = Format.Multiple(cell.Units);
        var credits = Format.Credits(Settlement.Credits(cell.Units, Bet));
        return new Tile(label.ToLowerInvariant(), credits,
            $"{place}: {label}, {credits} credits, {multiple} times the bet", $"{multiple}× bet",
            current!.NewCells.Contains(index), cell.Kind == CellKind.Cash ? CrateArt(cell.Units, index) : $"medal-{label.ToLowerInvariant()}");
    }

    // The air tank is a render, not a symbol of the sprite. It already leans, so it is not turned like the crates.
    private const string AirTankArt = "air-tank";

    // A small turn per cell so that crates of one tier do not stand in the board like stamps.
    private static readonly string[] Tilts = ["-1.8deg", "0.9deg", "-0.6deg", "1.8deg", "-1.2deg"];

    // Three drawings of the same empty well, laid out so that no two neighbours match.
    private const string WellPattern = "abcbcacabbcacab";

    // Two drawings of each crate tier, chosen by the cell so that a crate keeps its look from spin to spin.
    private const string CratePattern = "abbaababbabaaba";

    private static string CrateArt(int units, int index) =>
        $"crate-{(units <= 250 ? "low" : units <= 1000 ? "mid" : "high")}-{CratePattern[index]}";

    private static string Bottle(bool filled, bool lastBreath) => filled ? (lastBreath ? "bottle-low" : "bottle-full") : "bottle-empty";

    private sealed record Prize(string Label, string Value, string State, string Name, string Tip, bool Hit, bool IsNew);

    private IEnumerable<Prize> Prizes()
    {
        var cells = current?.Cells ?? new Cell[Board.Size];
        var before = shown > 1 ? spins[shown - 2].Cells : new Cell[Board.Size];
        (string Label, int Units)[] jackpots =
        [
            ("Mini", Config.Jackpots.Mini), ("Minor", Config.Jackpots.Minor), ("Major", Config.Jackpots.Major),
        ];
        foreach (var (label, prizeUnits) in jackpots)
        {
            var count = Landed(cells, prizeUnits);
            yield return PrizeFor(label, prizeUnits, count > 0 ? $"{count} landed" : "", count > Landed(before, prizeUnits));
        }

        var full = cells.All(cell => !cell.IsEmpty);
        yield return PrizeFor("Grand", Config.Grand, full ? "Full board" : "", full && !before.All(cell => !cell.IsEmpty));
    }

    private static int Landed(Cell[] cells, int prizeUnits) =>
        cells.Count(cell => cell.Kind == CellKind.Jackpot && cell.Units == prizeUnits);

    private Prize PrizeFor(string label, int prizeUnits, string state, bool isNew)
    {
        var multiple = Format.Multiple(prizeUnits);
        var credits = Format.Credits(Settlement.Credits(prizeUnits, Bet));
        var name = $"{label}, {credits} credits, {multiple} times the bet" + (state == "" ? "" : $", {state}");
        return new Prize(label, credits, state, name, $"{multiple}× bet", state != "", isNew);
    }
}
