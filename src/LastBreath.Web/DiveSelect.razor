<section class="select" aria-labelledby="dives-title">
    <div class="select-body">
        <h2 id="dives-title">Salvage what you can before your air runs out.</h2>
        <div class="cards" role="radiogroup" aria-label="Choose a dive">
            @for (var i = 0; i < Dives.Count; i++)
            {
                var dive = Dives[i];
                var key = i + 1;
                <label class="card">
                    <input type="radio" name="dive" class="sr-only" value="@dive.Id"
                           checked="@(Selected == dive.Id)" @onchange="() => SelectedChanged.InvokeAsync(dive.Id)"
                           aria-labelledby="name-@dive.Id" aria-describedby="rule-@dive.Id waves-@dive.Id @(Maths ? $"facts-{dive.Id}" : "")"
                           aria-keyshortcuts="@key" />
                    <span class="card-body">
                        <span class="pic-frame">
                            @* Each card is a place on the seabed: a wreck for Classic, a current for Drift and a weed bed for Tank. *@
                            <svg class="pic" viewBox="0 0 300 150" aria-hidden="true" focusable="false">
                                <use href="#panel" />
                                @switch (dive.Id)
                                {
                                    case "Classic":
                                        <use href="#hull" x="112" y="12" width="188" height="103" />
                                        <use href="#seabed" x="0" y="110" width="300" height="40" />
                                        <use href="#crate-mid-a" x="6" y="40" width="115" height="100" />
                                        for (var breath = 0; breath < 3; breath++)
                                        {
                                            <use href="#bottle-full" x="@(146 + breath * 34)" y="66" width="30" height="60" />
                                        }
                                        break;
                                    case "Static":
                                        <use href="#current" width="300" height="150" />
                                        <use href="#seabed" x="0" y="110" width="300" height="40" />
                                        <use href="#crate-low-a" x="8" y="20" width="92" height="80" transform="rotate(-10 54 60)" />
                                        <use href="#crate-low-b" x="106" y="44" width="86" height="75" transform="rotate(7 149 81)" />
                                        <use href="#crate-mid-b" x="196" y="10" width="96" height="84" transform="rotate(-5 244 52)" />
                                        break;
                                    default:
                                        <use href="#frond" x="0" y="34" width="34" height="94" />
                                        <use href="#frond" x="262" y="18" width="40" height="110" />
                                        <use href="#seabed" x="0" y="110" width="300" height="40" />
                                        for (var breath = 0; breath < 4; breath++)
                                        {
                                            <use href="#bottle-full" x="@(30 + breath * 22)" y="76" width="22" height="44" />
                                        }
                                        <use href="#crate-mid-b" x="184" y="50" width="88" height="77" />
                                        break;
                                }
                            </svg>
                            @if (dive.Id == "Tank")
                            {
                                <AirTankImage Class="pic-tank" />
                            }
                        </span>
                        <span class="card-top">
                            <span class="key" aria-hidden="true">@key</span>
                            <span class="name" id="name-@dive.Id">@dive.Name</span>
                            <span class="mark" aria-hidden="true"></span>
                        </span>
                        <span class="rule" id="rule-@dive.Id">@(Maths ? dive.Rule : dive.Line)</span>
                        <span class="waves" id="waves-@dive.Id" title="Volatility @dive.Volatility.ToLowerInvariant()">
                            <span class="waves-name">Volatility</span><span class="@(Maths ? "waves-level" : "sr-only")"> @dive.Volatility.ToLowerInvariant()</span>
                            @for (var wave = 1; wave <= 3; wave++)
                            {
                                <svg class="wave @(wave <= dive.Waves ? "on" : "")" viewBox="0 0 24 12" aria-hidden="true" focusable="false"><path d="M2 8c3-6 7-6 10 0s7 6 10 0" /></svg>
                            }
                        </span>
                        @if (Maths)
                        {
                            <span class="facts" id="facts-@dive.Id">
                                <span class="fact"><span class="fact-name">Hit frequency</span> <span class="fact-value">@Format.Percent(dive.Figures.HitFrequency)</span></span>
                                <span class="fact"><span class="fact-name">Typical length</span> <span class="fact-value">@dive.Figures.TypicalLength</span></span>
                                <span class="fact"><span class="fact-name">RTP</span> <span class="fact-value">@Format.Percent(dive.Figures.Rtp)</span></span>
                            </span>
                        }
                    </span>
                </label>
            }
        </div>

        @if (Maths)
        {
            <ol class="steps" aria-label="How a round goes">
                <li>
                    <svg class="step-pic" viewBox="0 0 160 64" aria-hidden="true" focusable="false">
                        <use href="#panel" />
                        <use href="#well-a" x="8" y="12" width="44" height="38.3" />
                        <use href="#well-b" x="58" y="12" width="44" height="38.3" />
                        <use href="#well-c" x="108" y="12" width="44" height="38.3" />
                    </svg>
                    <p><span class="step-no" aria-hidden="true">1</span> The board starts empty</p>
                </li>
                <li>
                    <svg class="step-pic" viewBox="0 0 160 64" aria-hidden="true" focusable="false">
                        <use href="#panel" />
                        <use href="#well-a" x="8" y="12" width="44" height="38.3" />
                        <use href="#well-b" x="58" y="12" width="44" height="38.3" />
                        <use href="#well-c" x="108" y="12" width="44" height="38.3" />
                        <use href="#crate-mid-a" x="2" y="6" width="56" height="48.7" />
                        <use href="#crate-low-b" x="102" y="6" width="56" height="48.7" />
                    </svg>
                    <p><span class="step-no" aria-hidden="true">2</span> Crates land and lock in their cell</p>
                </li>
                <li>
                    <svg class="step-pic" viewBox="0 0 160 64" aria-hidden="true" focusable="false">
                        <use href="#panel" />
                        <use href="#bottle-full" x="24" y="8" width="24" height="48" />
                        <use href="#bottle-low" x="68" y="8" width="24" height="48" />
                        <use href="#bottle-empty" x="112" y="8" width="24" height="48" />
                    </svg>
                    <p><span class="step-no" aria-hidden="true">3</span> When the breaths run out, you surface</p>
                </li>
            </ol>
        }
    </div>

    <div class="stake">
        <div class="bets" role="radiogroup" aria-labelledby="bet-title">
            <p id="bet-title" class="field-title">Bet</p>
            <div class="chips">
                @foreach (var amount in Bets)
                {
                    <label class="chip">
                        <input type="radio" name="bet" class="sr-only" value="@Format.Credits(amount)"
                               checked="@(Bet == amount)" @onchange="() => BetChanged.InvokeAsync(amount)" />
                        <span>@Format.Credits(amount)</span>
                    </label>
                }
            </div>
        </div>

        <div class="go">
            <button type="button" class="primary dive" @ref="diveButton" disabled="@(!CanDive)" @onclick="OnDive">Dive</button>
            @if (!CanDive)
            {
                <p class="note">Not enough credits for this bet. Choose a smaller bet or reset the balance.</p>
            }
        </div>
    </div>
</section>

@inject IJSRuntime JS

@code {
    private ElementReference diveButton;

    [Parameter, EditorRequired] public IReadOnlyList<DiveInfo> Dives { get; set; } = default!;
    [Parameter, EditorRequired] public decimal[] Bets { get; set; } = default!;
    [Parameter] public decimal Balance { get; set; }
    [Parameter] public bool Maths { get; set; }
    [Parameter] public string Selected { get; set; } = "";
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
    [Parameter] public decimal Bet { get; set; }
    [Parameter] public EventCallback<decimal> BetChanged { get; set; }
    [Parameter] public bool FocusDive { get; set; }
    [Parameter] public EventCallback OnDive { get; set; }

    private bool CanDive => Balance >= Bet;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Coming back from a round the button takes focus. On a first visit it takes focus only if nothing else has it, so that Enter starts a round
        // and a visitor who has already clicked somewhere keeps their place. It never scrolls the page.
        if (FocusDive) await diveButton.FocusAsync(preventScroll: true);
        else await JS.InvokeVoidAsync("lastBreath.focusIfIdle", diveButton);
    }
}
